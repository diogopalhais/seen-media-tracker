# Copy to apps/api/.env for local development (never commit .env).
PORT=3000
DATABASE_URL=postgres://seen:seen@localhost:5434/seen
# Generate with: pnpm --filter @seen/api hash-password
OWNER_PASSWORD_HASH=
# TMDB API read access token (v4 auth) from https://www.themoviedb.org/settings/api
TMDB_API_TOKEN=
TMDB_LANGUAGE=en-US
# Comma-separated list of allowed web app origins
CORS_ORIGINS=http://localhost:5173
# Set to 1 when running behind Coolify/Traefik so X-Forwarded-For is trusted
TRUST_PROXY=0
LOG_LEVEL=debug

{
  "name": "seen",
  "private": true,
  "version": "0.1.0",
  "description": "Seen \u2014 a personal movie and TV tracker",
  "packageManager": "pnpm@10.29.3",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "pnpm --filter @seen/api dev",
    "dev:web": "pnpm --filter @seen/web dev",
    "db:up": "docker compose -f compose.dev.yaml up -d",
    "db:down": "docker compose -f compose.dev.yaml down",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "typecheck": "pnpm -r --filter './packages/*' --filter './apps/*' typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "build": "pnpm -r --filter './packages/*' --filter './apps/*' build",
    "deploy:web": "pnpm --filter @seen/web build && pnpm --filter @seen/web cf:deploy"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.13",
    "typescript": "~5.9.3",
    "vitest": "^4.1.11"
  }
}
